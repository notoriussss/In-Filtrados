# Copy to .env (cp .env.example .env). S1-03 adds the variables of every service here.
MATCH_DB_NAME=match
MATCH_DB_USER=match_user
MATCH_DB_PASSWORD=match_dev_password
MATCH_DB_URL=postgresql://match_user:match_dev_password@match-db:5432/match

PLAYERS_DB_NAME=players
PLAYERS_DB_USER=players_user
PLAYERS_DB_PASSWORD=players_dev_password
PLAYERS_DB_URL=postgresql://players_user:players_dev_password@players-db:5432/players

RABBITMQ_USER=contaminador
RABBITMQ_PASSWORD=rabbit_dev_password
RABBITMQ_URL=amqp://contaminador:rabbit_dev_password@rabbitmq:5672/

MATCH_GRPC_ADDR=match:50051
PLAYERS_GRPC_ADDR=players:50052
MAP_PATH=/app/shared/map.json
GATEWAY_URL=http://localhost:3000