# deploy/lab.env.example — copia a deploy/lab.env y cambia las IP del día.
# El lab.env real NO se sube (tiene contraseñas). Es el mismo archivo en las
# 5 laptops: docs/deployment-lab.md, sección 5.

# Imágenes publicadas por el CD (ghcr.io/<dueño>/in-filtrados-<servicio>)
IMAGE_REGISTRY=ghcr.io/notoriussss
IMAGE_TAG=latest

# IP de cada nodo (las asigna el DHCP del laboratorio)
EDGE_HOST=192.168.10.21
MATCH_HOST=192.168.10.22
PLAYERS_HOST=192.168.10.23
BROKER_HOST=192.168.10.24
MONITOR_HOST=192.168.10.25

# RabbitMQ (N4): usuario propio; guest solo sirve en localhost
RABBITMQ_USER=game
RABBITMQ_PASSWORD=CHANGE_ME

# Bases de datos: cada una solo en la red interna de Docker de su nodo
MATCH_DB_NAME=match
MATCH_DB_USER=match
MATCH_DB_PASSWORD=CHANGE_ME
PLAYERS_DB_NAME=players
PLAYERS_DB_USER=players
PLAYERS_DB_PASSWORD=CHANGE_ME

# Direcciones derivadas: no hace falta tocarlas
MATCH_GRPC_ADDR=${MATCH_HOST}:50051
PLAYERS_GRPC_ADDR=${PLAYERS_HOST}:50052
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${BROKER_HOST}:5672
MATCH_DB_URL=postgresql://${MATCH_DB_USER}:${MATCH_DB_PASSWORD}@match-db:5432/${MATCH_DB_NAME}
PLAYERS_DB_URL=postgresql://${PLAYERS_DB_USER}:${PLAYERS_DB_PASSWORD}@players-db:5432/${PLAYERS_DB_NAME}
MAP_PATH=/app/shared/map.json

# Reconexión: el jugador desconectado conserva su lugar 10 minutos
# (docs/deployment-lab.md, sección 9)
RECONNECT_GRACE_SECONDS=600

# Health endpoints que consulta el monitor (N5)
WEB_HEALTH_URL=http://${EDGE_HOST}:8080/health
GATEWAY_HEALTH_URL=http://${EDGE_HOST}:3000/health
MATCH_HEALTH_URL=http://${MATCH_HOST}:8081/health
PLAYERS_HEALTH_URL=http://${PLAYERS_HOST}:8082/health
